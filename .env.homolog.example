# Ambiente de homologacao (sem segredos reais)
# Copie este arquivo para .env.homolog fora do Git e substitua os placeholders.

NODE_ENV=production
PORT=3099
SITE_PUBLIC_URL=https://homolog.example.org

# Homologacao deve usar banco e segredo proprios, nunca os de producao.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO_HOMOLOG
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA_E_EXCLUSIVA
ALLOW_DEMO_SEED=0

# Reproduz em homologacao as protecoes usadas em producao.
FORCE_SECURE_COOKIES=1
FORCE_CSP=1
TRUST_PROXY=1

# Servicos externos de homologacao (opcionais).
# Use contas, caixas de e-mail e buckets separados dos de producao.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_NOTIFY_TO=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL_BASE=
# S3_KEY_PREFIX=homolog/uploads
# S3_FORCE_PATH_STYLE=1
